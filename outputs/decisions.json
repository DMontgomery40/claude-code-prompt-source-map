    {
     "verified": "tested",
     "id": "force5m",
     "mechanism": "env",
     "knob": "env-force-prompt-caching-5m",
     "input": "toggle",
     "note": "Forces 5 minutes. 0 and false count as off.",
     "effect": {
      "value": "5m"
     },
     "realize": {
      "env": {
       "FORCE_PROMPT_CACHING_5M": "1"
      }
     },
     "label": "FORCE_PROMPT_CACHING_5M",
     "provenance": [
      {
       "file": "chunk-x9fwahqm.js",
