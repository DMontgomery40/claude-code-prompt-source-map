    "kind": {
     "main": {},
     "subagent": null
    },
    "auth": {
     "key": {},
     "subscription": null
    },
    "overage": {
     "false": {},
     "true": null
    },
    "provider": {
     "anthropic": {},
     "bedrock": null
    }
   },
