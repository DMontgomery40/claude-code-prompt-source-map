{
 "taxonomy_version": "02977bfe7901",
 "threshold": 0.7,
 "tags": [
  {
   "id": "auth-providers",
   "label": "Auth, providers and network",
   "kind": "topic",
   "definition": "Settings and environment variables for signing in and reaching model backends: login method and credential storage, API keys and access tokens, model provider definitions and base URLs, cloud-provider credentials (such as AWS/Bedrock), HTTP proxies, CA certificates and request headers. It applies in any group, including requirements: variants. It does not cover the sandbox's network allowlist for commands the agent runs, or MCP-server-specific auth.",
   "count": 50
  },
  {
   "id": "sandbox-approvals",
   "label": "Sandbox and approvals",
   "kind": "topic",
   "definition": "Settings that limit or approve what the agent may execute or touch: sandbox mode and permission profiles, filesystem and network access for commands, approval policy and approvals reviewer (including guardian auto-review), exec-policy / prefix rules, shell environment policy, and variables Codex sets to mark or escalate sandboxed processes. It applies in any group, including features.* flags and requirements: variants. It does not cover keybindings in approval dialogs or generic terminal-detection variables.",
   "count": 15
  },
  {
   "id": "built-in-tools",
   "label": "Built-in tools",
   "kind": "topic",
   "definition": "Settings for tools that ship with Codex and that the model calls directly: shell / unified exec and background terminals, apply_patch, plan updates, web search, browser use, computer use, image generation and viewing, JS REPL and code mode, clock/sleep and async user-message tools, and tool discovery or suggestion. It applies in any group, including features.* flags and requirements: variants. It does not cover external MCP servers or approval policy in general.",
   "count": 4
  },
  {
   "id": "mcp-plugins",
   "label": "MCP, plugins and skills",
   "kind": "topic",
   "definition": "Settings for extending Codex with external or packaged capabilities: MCP server definitions (command, URL, auth, timeouts, per-tool limits), plugins and marketplaces, skills, and connected apps. It applies in any group, including features.* flags and requirements: variants. It does not cover tools built into Codex such as web search or shell, or sub-agent coordination.",
   "count": 8
  },
  {
   "id": "telemetry-storage",
   "label": "Telemetry, logs and storage",
   "kind": "topic",
   "definition": "Settings and environment variables for observability and local state: OpenTelemetry exporters and trace context, analytics and feedback, log levels and formats, transcript/history persistence, rollout and session files, and Codex home or database paths. It applies in any group, including features.* flags and requirements: variants. It does not cover the model's memory of past sessions or lifecycle hooks.",
   "count": 28
  },
  {
   "id": "ui",
   "label": "Terminal and desktop UI",
   "kind": "topic",
   "definition": "Settings and environment variables that change how the terminal UI or desktop app looks and behaves for the user: TUI options, keymaps and vim mode, themes and rendering, notices and prompts, desktop-app window or runtime behavior, and terminal detection. It applies in any group. It does not cover what the model can do, or third-party library variables that only happen to be read by the desktop bundle.",
   "count": 24
  },
  {
