{
  // The one site: static assets on Cloudflare Workers. Deploy: cd site && npm test && npm run build && npx wrangler deploy
  "name": "harness-source-map",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "harness.dtmont.com", "custom_domain": true }]
}
